{
  "name": "inscript-editor",
  "version": "0.1.0",
  "description": "Standalone TipTap-based rich text editor extracted from Inscript.",
  "author": "Harsh Ankur <harshankur@outlook.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/inscript-editor.cjs.js",
  "module": "./dist/inscript-editor.es.js",
  "types": "./src/types.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/types.d.ts",
    "src/locales"
  ],
  "exports": {
    ".": {
      "import": "./dist/inscript-editor.es.js",
      "require": "./dist/inscript-editor.cjs.js",
      "types": "./src/types.d.ts"
    },
    "./styles": "./dist/styles/inscript-editor.css",
    "./locales": {
      "import": "./src/locales/index.js",
      "types": "./src/locales/types.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshankur/inscript-editor.git"
  },
  "keywords": [
    "tiptap",
    "rich-text-editor",
    "wysiwyg",
    "react",
    "editor",
    "prosemirror",
    "cms",
    "i18n"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:dist": "npm run build && vitest run tests/dist"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.20.4",
    "@tiptap/extension-color": "^3.20.4",
    "@tiptap/extension-highlight": "^3.20.4",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-subscript": "^3.20.4",
    "@tiptap/extension-superscript": "^3.20.4",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extension-table-cell": "^3.23.6",
    "@tiptap/extension-table-header": "^3.23.6",
    "@tiptap/extension-table-row": "^3.23.6",
    "@tiptap/extension-text-align": "^3.20.4",
    "@tiptap/extension-text-style": "^3.20.4",
    "@tiptap/extension-underline": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "diff": "^8.0.3",
    "i18next": "^25.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tiptap/core": "^3.20.4",
    "@tiptap/extension-color": "^3.20.4",
    "@tiptap/extension-highlight": "^3.20.4",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-subscript": "^3.20.4",
    "@tiptap/extension-superscript": "^3.20.4",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extension-table-cell": "^3.23.6",
    "@tiptap/extension-table-header": "^3.23.6",
    "@tiptap/extension-table-row": "^3.23.6",
    "@tiptap/extension-text-align": "^3.20.4",
    "@tiptap/extension-text-style": "^3.20.4",
    "@tiptap/extension-underline": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "diff": "^8.0.3",
    "i18next": "^25.10.5",
    "jsdom": "^27.4.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.6.2",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.9"
  }
}
